// -------------------------
// Search
// -------------------------

const searchInput = document.getElementById("search-input");
const searchResults = document.getElementById("search-results");

searchInput.addEventListener("input", () => {
    const query = searchInput.value.trim().toLowerCase();

    searchResults.innerHTML = "";

    if (!query) {
        return;
    }

    const results = suggestions.filter(item =>
        item.title.toLowerCase().includes(query) ||
        item.description.toLowerCase().includes(query) ||
        item.category.toLowerCase().includes(query)
    );

    if (results.length === 0) {
        searchResults.innerHTML =
            `<div class="feature-card">
                No results found.
            </div>`;

        return;
    }

    results.forEach(item => {
        const result = document.createElement("div");

        result.className = "content-list";

        result.innerHTML = `
            <div>
                <strong>${item.title}</strong><br>
                <small>${item.category}</small>
            </div>
        `;

        searchResults.appendChild(result);
    });
});

// -------------------------
// Reaction Game
// -------------------------

const reactionButton =
    document.getElementById("reaction-button");

const reactionResult =
    document.getElementById("reaction-result");

let reactionStart = 0;
let reactionTimer = null;
let waitingForReaction = false;

reactionButton.addEventListener("click", () => {

    if (waitingForReaction) {
        const reactionTime = Date.now() - reactionStart;

        reactionResult.textContent =
            `⚡ Your reaction time: ${reactionTime} ms`;

        reactionButton.textContent = "Play Again";

        waitingForReaction = false;

        clearTimeout(reactionTimer);

        return;
    }

    reactionButton.textContent = "Wait...";

    reactionResult.textContent =
        "Get ready...";

    waitingForReaction = true;

    const delay = 1000 + Math.random() * 3000;

    reactionTimer = setTimeout(() => {

        reactionStart = Date.now();

        reactionButton.textContent =
            "CLICK NOW! ⚡";

        reactionResult.textContent =
            "GO!";

    }, delay);
});

// -------------------------
// Brain Challenges
// -------------------------

function loadChallenge() {

    const challenge =
        brainChallenges[currentChallenge];

    document.getElementById("challenge-question")
        .textContent = challenge.question;

    const optionsContainer =
        document.getElementById("challenge-options");

    optionsContainer.innerHTML = "";

    challenge.options.forEach((option, index) => {

        const button =
            document.createElement("button");

        button.className =
            "challenge-option";

        button.textContent =
            option;

        button.addEventListener("click", () => {

            if (index === challenge.answer) {
                showToast("Correct! 🧠");
            } else {
                showToast("Not quite. Try another one!");
            }

        });

        optionsContainer.appendChild(button);
    });
}

document.getElementById("next-challenge")
    .addEventListener("click", () => {

        currentChallenge++;

        if (currentChallenge >= brainChallenges.length) {
            currentChallenge = 0;
        }

        loadChallenge();
    });

