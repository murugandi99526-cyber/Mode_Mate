// -------------------------
// Daily Content
// -------------------------

function getDayIndex(arrayLength) {
    const now = new Date();

    const start = new Date(now.getFullYear(), 0, 0);
    const difference = now - start;
    const oneDay = 1000 * 60 * 60 * 24;

    return Math.floor(difference / oneDay) % arrayLength;
}

function setDailyContent() {
    document.getElementById("daily-activity").textContent =
        dailyActivities[getDayIndex(dailyActivities.length)];

    document.getElementById("daily-challenge").textContent =
        dailyChallenges[getDayIndex(dailyChallenges.length)];
}

// -------------------------
// Thought Generator
// -------------------------

const thoughtInput = document.getElementById("thought-input");
const generateButton = document.getElementById("generate-button");
const suggestionsContainer = document.getElementById("suggestions");

generateButton.addEventListener("click", () => {
    const text = thoughtInput.value.trim();

    if (!text) {
        showToast("Tell VibeX what's on your mind first.");
        return;
    }

    generateSuggestions(text);
});

document.querySelectorAll(".quick-options button").forEach(button => {
    button.addEventListener("click", () => {
        const text = button.dataset.thought;

        thoughtInput.value = text;
        generateSuggestions(text);
    });
});

function generateSuggestions(input) {
    const lowerInput = input.toLowerCase();

    let matching = suggestions.filter(item =>
        item.keywords.some(keyword => lowerInput.includes(keyword))
    );

    let remaining = suggestions.filter(item => !matching.includes(item));

    shuffle(matching);
    shuffle(remaining);

    const finalSuggestions = [...matching, ...remaining].slice(0, 5);

    renderSuggestions(finalSuggestions);
}

function renderSuggestions(items) {
    suggestionsContainer.innerHTML = "";

    items.forEach(item => {
        const card = document.createElement("div");

        card.className = "suggestion-card";

        card.innerHTML = `
            <div class="category">${item.category}</div>

            <h3>${item.title}</h3>

            <p>${item.description}</p>

            <div class="card-actions">
                <button class="start-button">
                    Start
                </button>

                <button class="favorite-button">
                    ♡
                </button>
            </div>
        `;

        const startButton = card.querySelector(".start-button");

        startButton.addEventListener("click", () => {
            showToast(`Starting: ${item.title}`);
        });

        const favoriteButton =
            card.querySelector(".favorite-button");

        favoriteButton.addEventListener("click", () => {
            favoriteButton.textContent = "♥";
            showToast("Added to favorites ❤️");
        });

        suggestionsContainer.appendChild(card);
    });
}

