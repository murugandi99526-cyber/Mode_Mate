* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --bg: #070812;
    --panel: rgba(18, 20, 38, 0.72);
    --panel-solid: #111426;
    --text: #f5f7ff;
    --muted: #9298b5;
    --accent: #8b7cff;
    --accent-2: #4de8ff;
    --border: rgba(255, 255, 255, 0.09);
}

body {
    font-family: Arial, sans-serif;
    background:
        radial-gradient(circle at 20% 10%, rgba(139, 124, 255, 0.18), transparent 28%),
        radial-gradient(circle at 80% 20%, rgba(77, 232, 255, 0.12), transparent 25%),
        var(--bg);
    color: var(--text);
    min-height: 100vh;
    overflow-x: hidden;
}

/* Loading */

#loading-screen {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: #05060d;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    animation: loadingFade 1s ease 2s forwards;
}

.logo-symbol,
.small-logo {
    display: flex;
    justify-content: center;
    align-items: center;
    font-weight: 900;
    border-radius: 18px;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    color: white;
    box-shadow: 0 0 45px rgba(139, 124, 255, 0.6);
}

.logo-symbol {
    width: 82px;
    height: 82px;
    font-size: 42px;
    animation: pulse 1.2s infinite alternate;
}

#loading-screen h1 {
    margin-top: 20px;
    font-size: 38px;
}

#loading-screen p {
    color: var(--muted);
    margin-top: 8px;
}

@keyframes pulse {
    from {
        transform: scale(0.95);
    }
    to {
        transform: scale(1.05);
    }
}

@keyframes loadingFade {
    to {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
    }
}

/* Side menu */

#side-menu {
    position: fixed;
    left: -280px;
    top: 0;
    width: 270px;
    height: 100vh;
    z-index: 900;
    padding: 25px 18px;
    background: rgba(8, 10, 22, 0.96);
    backdrop-filter: blur(25px);
    border-right: 1px solid var(--border);
    transition: left 0.3s ease;
}

#side-menu.open {
    left: 0;
}

.menu-logo {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 22px;
    font-weight: bold;
    margin-bottom: 30px;
}

.small-logo {
    width: 38px;
    height: 38px;
    border-radius: 10px;
}

nav {
    display: flex;
    flex-direction: column;
    gap: 7px;
}

nav button {
    border: 0;
    background: transparent;
    color: var(--muted);
    padding: 13px 14px;
    text-align: left;
    border-radius: 12px;
    font-size: 15px;
    cursor: pointer;
    transition: 0.2s;
}

nav button:hover {
    color: white;
    background: rgba(255, 255, 255, 0.07);
}

/* Header */

header {
    height: 70px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 22px;
    border-bottom: 1px solid var(--border);
    background: rgba(7, 8, 18, 0.7);
    backdrop-filter: blur(20px);
    position: sticky;
    top: 0;
    z-index: 500;
}

#menu-button,
#notification-button {
    background: transparent;
    border: 0;
    color: white;
    font-size: 23px;
    cursor: pointer;
}

.header-logo {
    font-weight: 900;
    font-size: 21px;
    letter-spacing: 1px;
}

/* Main */

#app {
    min-height: 100vh;
}

.page {
    display: none;
    width: min(1100px, 92%);
    margin: auto;
    padding: 45px 0 80px;
}

.page.active {
    display: block;
}

/* Hero */

.hero {
    position: relative;
    padding: 55px 0 30px;
}

.eyebrow,
.page-title small,
.section-heading small,
.daily-card small {
    color: var(--accent-2);
    letter-spacing: 2px;
    font-size: 11px;
    font-weight: bold;
}

.hero h1 {
    position: relative;
    max-width: 750px;
    margin-top: 14px;
    font-size: clamp(48px, 8vw, 88px);
    line-height: 0.98;
    letter-spacing: -4px;
}

.hero h1 span {
    color: var(--accent);
}

.hero-text {
    position: relative;
    color: var(--muted);
    max-width: 580px;
    line-height: 1.7;
    margin: 25px 0;
}

.hero-glow {
    position: absolute;
    width: 350px;
    height: 350px;
    right: 5%;
    top: 30px;
    border-radius: 50%;
    background: var(--accent);
    filter: blur(130px);
    opacity: 0.12;
}

/* Input */

.thought-box {
    position: relative;
    max-width: 720px;
    padding: 7px;
    border: 1px solid var(--border);
    background: var(--panel);
    border-radius: 20px;
    backdrop-filter: blur(20px);
}

textarea {
    width: 100%;
    min-height: 95px;
    resize: vertical;
    padding: 18px;
    background: transparent;
    border: 0;
    outline: 0;
    color: white;
    font-size: 16px;
}

textarea::placeholder {
    color: #6f7590;
}

#generate-button,
.primary-button,
#surprise-button {
    border: 0;
    color: white;
    background: linear-gradient(135deg, var(--accent), #6454ef);
    border-radius: 13px;
    padding: 13px 20px;
    cursor: pointer;
    font-weight: bold;
    box-shadow: 0 8px 25px rgba(100, 84, 239, 0.25);
}

#generate-button {
    margin: 0 7px 7px auto;
    display: block;
}

.quick-options {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: 14px;
}

.quick-options button {
    border: 1px solid var(--border);
    background: rgba(255,255,255,0.04);
    color: var(--muted);
    padding: 10px 14px;
    border-radius: 999px;
    cursor: pointer;
}

/* Daily */

.daily-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 15px;
    margin: 25px 0 65px;
}

.daily-card,
.feature-card,
.profile-card,
.leaderboard,
.content-list > div {
    border: 1px solid var(--border);
    background: var(--panel);
    backdrop-filter: blur(18px);
    border-radius: 20px;
}

.daily-card {
    padding: 20px;
    display: flex;
    gap: 15px;
    align-items: center;
}

.daily-card > span {
    font-size: 28px;
}

.daily-card h3 {
    margin-top: 7px;
    font-size: 16px;
}

/* Sections */

.section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 20px;
    margin-bottom: 20px;
}

.section-heading h2 {
    margin-top: 7px;
}

.card-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 15px;
}

.suggestion-card {
    padding: 24px;
    min-height: 190px;
    border: 1px solid var(--border);
    border-radius: 20px;
    background: linear-gradient(
        145deg,
        rgba(255,255,255,0.07),
        rgba(255,255,255,0.025)
    );
   
